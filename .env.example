# Stellar network to connect to. `testnet` or `mainnet`
VITE_STELLAR_NETWORK=testnet

# Base URL of the devpulsar-backend API (e.g. https://api.devpulsar.io)
VITE_BACKEND_URL=https://api.devpulsar.io

# Stellar smart contract address for the DevPulsar rewards contract
VITE_CONTRACT_ADDRESS=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Custom Horizon server URL. Defaults to the public Stellar Horizon endpoint
VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint for contract interactions. Defaults to the public RPC
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
